# ---- n8n ----
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_HOST=localhost
# Public URL Telegram can reach (ngrok static domain). Leave http://localhost:5678 if using polling mode.
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata

# ---- ngrok (only for Telegram webhook mode) ----
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app

# ---- LLM: Gemini free tier (https://aistudio.google.com/apikey) ----
# Free quotas (AI Studio > Rate Limit, checked 2026-11-15): full Flash models = 5 req/min, 20/day (too low);
# Flash-Lite models = 15 req/min, 500/day each; Gemma 4 = 30/min, 14.4K/day but slow/flaky.
# Chain: PRIMARY -> FALLBACK (separate quota bucket) -> FALLBACK2 -> fixed template pitch.
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK2=gemma-4-26b-a4b-it

# ---- Search (free tiers). Tavily primary, Serper fallback ----
TAVILY_API_KEY=
SERPER_API_KEY=

# ---- Contact finding (free tier ~50 credits/mo). Optional: pipeline degrades gracefully ----
HUNTER_API_KEY=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot. First ID is the admin (gets error alerts).
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- Google Sheet (service account shared on the sheet) ----
GOOGLE_SHEET_ID=

# ---- Behaviour ----
SANDBOX_MODE=true
SANDBOX_INBOX=your.test.inbox@gmail.com
FOLLOWUP_DELAY_MINUTES=2

# ---- Adapters ----
# local + dryrun work with zero Google setup (emails are written to DATA_DIR/outbox and previewed in Telegram).
# After the Google setup switch to: STORE_BACKEND=sheets  MAIL_BACKEND=gmail
STORE_BACKEND=local
MAIL_BACKEND=dryrun
DATA_DIR=/home/node/.n8n/bdr
DATA_DIR_HOST=./n8n_data/bdr

# Safety: real leads are only emailed when SANDBOX_MODE=false AND ALLOW_REAL_SEND=true
ALLOW_REAL_SEND=false
# Hard lock: comma-separated addresses that may receive mail. Nothing else can be sent to, in any mode.
# Required for MAIL_BACKEND=gmail. Use ONLY your own test addresses until you deliberately go live.
SEND_ALLOWLIST=

# ---- Google (only for STORE_BACKEND=sheets / MAIL_BACKEND=gmail). See docs/setup-google.md ----
# base64 of the service-account JSON key:  base64 -i key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_B64=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
